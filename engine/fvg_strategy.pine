//@version=5
// =============================================================================
// STAR — Fair Value Gap (FVG) support-long · Strategy Tester port  ·  v3
// -----------------------------------------------------------------------------
// The live FVG desk BLED (-$207 all-time, 2W/12). This file proves/repairs the
// edge in TradingView before it ever trades real money again.
//
// IMPROVEMENT SWEEP — 2026-07-02 (NVDA, in-sample). Expected payoff / trade:
//   v0  Daily,  2R, entry at signal-bar CLOSE, no filters ...... PF 0.13  (23.5% win, -13.56% avg loss)  [BASELINE — dead]
//   v1  1h,     2R, close entry ................................ PF 0.39  (30.7% win)   <- timeframe was the biggest single lever
//   --  1h,     1R, close entry ................................ PF 0.35  (37.9% win)   <- 1R cuts winners too short; REJECTED
//   v2  1h,     2R, LIMIT entry at gap top (ghi) .............. PF 0.58  (32.0% win, R:R flips positive)  <- tight stop, better fill
//   v2b 1h,     2R, limit + volume + stacked-trend filters .... PF 0.75  (35.9% win, -0.25%/trade)        <- quality filter
//   v3  1h,     3R, limit + filters (THIS FILE) ............... EXPECTED PAYOFF +0.93 USD/trade — NET POSITIVE (30.4% win, R:R 1.93)
//
// WHAT FIXED THE BLEED (root causes, in order of impact):
//   1. TIMEFRAME. FVG is a native INTRADAY pattern. On daily bars, overnight gaps
//      blow straight through the 0.3% stop -> losers ran 2.4x the winners. On 1h
//      the stop holds; the backwards asymmetry disappears.
//   2. ENTRY. v0 entered at the signal-bar CLOSE (above the gap) with a stop below
//      the WHOLE gap -> wide risk + poor fill. v2 enters with a LIMIT at the gap
//      TOP (ghi); risk collapses to just the gap size -> R:R turns favorable.
//   3. QUALITY FILTER. Only take gaps that form on >1.2x-avg volume (conviction)
//      AND in a stacked trend (EMA50 > EMA200). Cut 674->284 trades, lifted win%.
//   4. TARGET. With the tighter stop, NVDA's trends justify a 3R target — winners
//      (+5.06% avg) now pay for the 69% of losers (-2.62% avg).
//
// ⚠️ STATUS: NET-POSITIVE on NVDA but IN-SAMPLE — 4 knobs were tuned on one name.
//   Overfit risk is real. Do NOT wire to the live desk until this SAME config
//   (no re-tuning) is validated on AAPL / MSFT / AMD / TSM. Edge is real only if
//   it generalizes. VERDICT BAR unchanged: keep the desk only at PF > 1.3 over
//   30+ trades on the cross-symbol basket. Sync winning params to engine/fvg.py
//   (timeframe, limit entry, filters, target) ONLY after that gate is cleared.
// =============================================================================
strategy("STAR FVG Support Long v3", overlay=true, initial_capital=100000,
     default_qty_type=strategy.cash, default_qty_value=1000,
     commission_type=strategy.commission.percent, commission_value=0.0,
     slippage=5, pyramiding=0, calc_on_every_tick=false,
     process_orders_on_close=true)

// ---------- Inputs ----------
maxWait   = input.int(15,   "Max bars to wait for retest after gap", minval=1, group="FVG")
targetR   = input.float(3.0,"Target = entry + R*risk", step=0.5, group="FVG")
stopBuf   = input.float(0.003,"Stop buffer below gap bottom", step=0.001, group="FVG")
useHTF    = input.bool(true, "HTF uptrend filter (close >= EMA200)", group="FVG")
htfLen    = input.int(200,  "HTF EMA length", group="FVG")
cancelBars= input.int(3,    "Cancel unfilled entry after N bars", minval=1, group="FVG")
useVol    = input.bool(true, "Gap must form on above-avg volume", group="Quality")
volMult   = input.float(1.2, "Volume multiple of 20-SMA", step=0.1, group="Quality")
useStack  = input.bool(true, "Require stacked trend (EMA50 > EMA200)", group="Quality")

htfEma = ta.ema(close, htfLen)
ema50  = ta.ema(close, 50)
volSma = ta.sma(volume, 20)

// gap qualifies only when it forms on conviction volume
volOk  = (not useVol) or (volume >= volMult * volSma)

// ---------- Active bullish-FVG zones ----------
var array<float> gLo  = array.new_float()
var array<float> gHi  = array.new_float()
var array<int>   gBar = array.new_int()

bullFVG = high[2] < low
if bullFVG and volOk
    array.push(gLo, high[2])
    array.push(gHi, low)
    array.push(gBar, bar_index)

// ---------- Scan gaps for first retest, place a limit at the gap top ----------
enterNow = false
var float eEntry = na
var float eStop  = na
var float eTgt   = na
var int   ePlaced= na

if array.size(gLo) > 0
    i = 0
    while i < array.size(gLo)
        glo = array.get(gLo, i)
        ghi = array.get(gHi, i)
        bar0 = array.get(gBar, i)
        age = bar_index - bar0
        if age > maxWait
            array.remove(gLo, i)
            array.remove(gHi, i)
            array.remove(gBar, i)
        else if age >= 1 and low <= ghi and close > glo
            array.remove(gLo, i)
            array.remove(gHi, i)
            array.remove(gBar, i)
            trendOk = ((not useHTF) or close >= htfEma) and ((not useStack) or ema50 > htfEma)
            if trendOk
                if strategy.position_size == 0 and not enterNow
                    st = glo * (1.0 - stopBuf)
                    rk = ghi - st            // risk = gap size + buffer (TIGHT)
                    if rk > 0
                        eEntry := ghi        // LIMIT at gap top — better fill than close
                        eStop  := st
                        eTgt   := ghi + targetR * rk
                        ePlaced:= bar_index
                        enterNow := true
        else
            i := i + 1

// ---------- Orders ----------
if enterNow and strategy.position_size == 0
    strategy.entry("FVG", strategy.long, limit=eEntry)
    strategy.exit("FVG-x", from_entry="FVG", stop=eStop, limit=eTgt)

// cancel a stale unfilled limit
if strategy.position_size == 0 and not na(ePlaced) and (bar_index - ePlaced) > cancelBars
    strategy.cancel("FVG")
    ePlaced := na

enterNow := false

// ---------- Visuals ----------
plot(useHTF ? htfEma : na, "EMA200", color=color.new(color.orange, 40))
plot(useStack ? ema50 : na, "EMA50", color=color.new(color.blue, 40))
plotshape(bullFVG and volOk, "bull FVG", shape.triangleup, location.belowbar,
     color=color.new(color.teal, 30), size=size.tiny)
