//@version=5
// =============================================================================
// STAR — Volume-Weighted RSI · Pullback-in-Uptrend
// -----------------------------------------------------------------------------
// 1:1 port of engine/trading_signals.py so TradingView's Strategy Tester results
// are directly comparable to our Python backtest — but with TradingView's
// intraday data, deep history, and visual fills.
//
// Entry  : shallow pullback inside an uptrend
//            RSI in [rsiLo, rsiHi]  AND  close >= EMA50  AND  volume >= mult*avg
// Stop   : entry - atrStop * ATR        (fixed at entry, like the Python engine)
// Target : entry * (1 + tpPct)          (2% by default)
// Exit   : stop / target, OR RSI overbought / trend break
// Sizing : risk riskPct of equity per trade (entry -> stop distance)
// Fills  : next-bar open (no look-ahead) — matches our Python design.
//
// HOW TO USE:
//   1. TradingView → open any chart → Pine Editor (bottom panel).
//   2. Paste this whole file → "Add to chart".
//   3. Open the "Strategy Tester" tab to see net profit, win rate, profit
//      factor, max drawdown, Sharpe, and the full trade list.
//   4. Tune the inputs (gear icon) — start by lowering "Volume MA length" for
//      intraday, widening the RSI band, and trying 5m/15m timeframes for runners.
// =============================================================================
strategy("STAR VW-RSI Pullback", overlay=true, initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=0,
     commission_type=strategy.commission.percent, commission_value=0.0,
     slippage=5, pyramiding=0, calc_on_every_tick=false,
     process_orders_on_close=false)

// ---------- Inputs (tune these in the Strategy Tester gear) ----------
rsiLen  = input.int(14,    "RSI length", minval=2, group="Entry")
rsiLo   = input.float(30.0,"RSI band low (pullback floor)", group="Entry")
rsiHi   = input.float(55.0,"RSI band high (pullback ceiling)", group="Entry")
emaLen  = input.int(50,    "EMA trend filter", group="Entry")
volLen  = input.int(20,    "Volume MA length", group="Entry")
volMult = input.float(1.2, "Min volume x avg", step=0.1, group="Entry")

atrLen  = input.int(14,    "ATR length", group="Exit")
atrStop = input.float(1.2, "Stop = entry - x*ATR", step=0.1, group="Exit")
tpPct   = input.float(2.0, "Take-profit %", step=0.1, group="Exit") / 100.0
exitRsi = input.float(65.0,"Exit if RSI rises above", group="Exit")

riskPct = input.float(2.0, "Risk % of equity / trade", step=0.5, group="Risk") / 100.0

// ---------- Indicators ----------
r   = ta.rsi(close, rsiLen)
ema = ta.ema(close, emaLen)
vma = ta.sma(volume, volLen)
atr = ta.atr(atrLen)

// ---------- Entry: shallow pullback inside an uptrend ----------
longCond = r >= rsiLo and r <= rsiHi and close >= ema and volume >= volMult * vma

// risk-based position size (entry -> stop distance), like the Python engine
stopDist = atrStop * atr
qty = stopDist > 0 ? math.floor((strategy.equity * riskPct) / stopDist) : 0

// stop/target are LOCKED at entry (not trailed), to mirror the Python backtest
var float stopPx = na
var float tpPx   = na

if longCond and strategy.position_size == 0 and qty > 0
    strategy.entry("Long", strategy.long, qty=qty)
    stopPx := close - atrStop * atr
    tpPx   := close * (1.0 + tpPct)

if strategy.position_size > 0
    strategy.exit("Bracket", from_entry="Long", stop=stopPx, limit=tpPx)
    // discretionary exit: RSI overbought or trend break
    if r > exitRsi or close < ema
        strategy.close("Long", comment="signal")

// ---------- Plots ----------
plot(ema, "EMA50", color=color.new(color.orange, 0))
bgcolor(longCond ? color.new(color.green, 85) : na, title="Entry zone")
