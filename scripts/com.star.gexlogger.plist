<?xml version="1.0" encoding="UTF-8"?>
<!-- STAR — daily GEX snapshot launch agent.
     Runs scripts/log_gex.sh weekdays at 15:15 local time (after the US close).
     launchd runs a missed StartCalendarInterval job when the Mac next wakes,
     so this survives a closed/asleep laptop (unlike cron).
     Install:
       cp scripts/com.star.gexlogger.plist ~/Library/LaunchAgents/
       launchctl bootout gui/$(id -u)/com.star.gexlogger 2>/dev/null
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.star.gexlogger.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.star.gexlogger</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/anubhavarya/star/star-dashboard/scripts/log_gex.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/star_gex.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/star_gex.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
