<?xml version="1.0" encoding="UTF-8"?>
<!-- STAR — premarket research launch agent.
     Builds the graded runner watchlist weekdays at 7:45am local (before US open).
     launchd runs a missed job on wake, so a closed laptop still gets the brief.
     Install:
       cp scripts/com.star.premarket.plist ~/Library/LaunchAgents/
       launchctl bootout gui/$(id -u)/com.star.premarket 2>/dev/null
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.star.premarket.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.star.premarket</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/anubhavarya/star/star-dashboard/scripts/premarket.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/star_premarket.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/star_premarket.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
